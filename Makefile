ifneq ($(TARGET),mega65)
DRVWRITE := -write $(DRVFILE) $(TARGET)-reu.emd
endif

$(D81FILE): $(BINFILES) $(TXTFILES) $(THEMESDEF) $(HDRFILES)
	c1541 -format $(PROGRAM),8a d81 $(D81FILE) \
	-write $(EDITORAPP) pascal65,prg \
	-write $(COMPILER) compiler,prg \
	-write $(TOKENIZER) tokenizer,prg \
	-write $(PARSER) parser,prg \
	-write $(RESOLVER) resolver,prg \
	-write $(TYPECHECK) typecheck,prg \
	-write $(ICODE) icode,prg \
	-write $(TPU) tpu,prg \
	-write $(CODEGEN) codegen,prg \
	-write $(LINKER) linker,prg \
	-write $(MEMINFO) meminfo,prg \
	-write $(EDITOROVLY) editor,prg \
	-write $(THEMES) themes,prg \
	-write $(WORKDISK) workdisk,prg \
	-write $(MKHDR) mkhdr,prg \
	$(RTWRITE) \
	-write $(SCREENLIB) screen.lib,prg \
	-write $(SPRITESLIB) sprites.lib,prg \
	-write $(SPRITEMOVELIB) spritemove.lib,prg \
	-write $(SYSTEMLIB) system.lib,prg \
	-write $(ASMLIB) asm.lib,prg \
	-write $(TIMELIB) time.lib,prg \
	-write $(SOUNDLIB) sound.lib,prg \
	$(DRVWRITE) \
	-write abortmsgs.petscii abortmsgs,seq \
	-write errormsgs.petscii errormsgs.txt,seq \
	-write src/lib/loadprog/bin/$(TARGET)/loadprog loadprog,prg \
	-write help.petscii help.txt,seq \
	-write screen.petscii screen.pas,seq \
	-write screendemo.petscii screendemo.pas,seq \
	-write fivedice.petscii fivedice.pas,seq \
	-write time.petscii time.pas,seq \
	-write bubbles.petscii bubbles.pas,seq \
	-write sprites.petscii sprites.pas,seq \
	-write spritemove.petscii spritemove.pas,seq \
	-write sound.petscii sound.pas,seq \
	-write sfxdemo.petscii sfxdemo.pas,seq \
	-write tunedemo.petscii tunedemo.pas,seq \
	-write stereodemo.petscii stereodemo.pas,seq \
	-write system.petscii system.pas,seq \
	-write title.petscii title.txt,seq \
	-write license.petscii license.txt,seq \
	-write $(THEMESDEF) themes.dat,seq \
	-write $(THEMESDEF) themes.def,seq \
	$(foreach h,$(HDRFILES),-write $(h) $(notdir $(h)),prg)

# The Hangman game's disk, apart from the compiler's. It boots the intro,
# which loads the game. The game is compiled in the emulator (it's static,
# so it doesn't need runtimeN) and copied to examples/hangman.prg. The
# libraries and runtime files are there to compile it again.
hangman: $(HANGMAND81)

.PHONY: hangman

hangman-autoboot.prg: examples/hangman-autoboot.bas
	dos2unix < examples/hangman-autoboot.bas | petcat -w65 -o hangman-autoboot.prg

hangman.petscii: examples/hangman.pas
	dos2unix < examples/hangman.pas | petcat -w2 -text -o hangman.petscii

words.petscii: examples/words.txt
	dos2unix < examples/words.txt | petcat -w2 -text -o words.petscii

$(HANGMAND81): $(HANGMANPRG) hangman-autoboot.prg hangman.petscii \
		words.petscii $(SCREENLIB) $(SOUNDLIB) $(RUNTIME) | $(BINTARGETDIR)
	c1541 -format hangman,8a d81 $(HANGMAND81) \
	-write hangman-autoboot.prg autoboot.c65,prg \
	-write $(HANGMANPRG) hangman,prg \
	-write words.petscii words,seq \
	-write hangman.petscii hangman.pas,seq \
	-write $(SCREENLIB) screen.lib,prg \
	-write $(SOUNDLIB) sound.lib,prg \
	$(RTWRITE)

# Builds just mkhdr and its standalone disk image. mkhdr is also on the main
# disk, which holds the tokenizer, parser, and library sources it needs. Run it
# on the emulator for each library unit, then copy the .hdr files to src/lib/hdr.
mkhdr:
	cd $(MKHDRDIR) && $(MAKE) TARGET=$(TARGET)

.PHONY: mkhdr

clean:
	cd src/apps && $(MAKE) TARGET=$(TARGET) clean
	cd src/lib && $(MAKE) TARGET=$(TARGET) clean
	cd src/overlays && $(MAKE) TARGET=$(TARGET) clean
	$(RM) $(TXTFILES)
	$(RM) $(THEMESDEF)
	$(RM) $(D81FILE)
	$(RM) $(BLANKD81) $(WORKD81) $(WORKMARKER)
	$(RM) $(HANGMAND81) hangman-autoboot.prg hangman.petscii words.petscii

RUNDEPS = $(RUNTIME) editorapp compiler $(SYSTEMLIB) $(SCREENLIB) $(ASMLIB) $(SPRITESLIB) $(SPRITEMOVELIB) $(BINTARGETDIR) $(D81FILE)

# Runs the IDE with a blank disk on unit 9, made fresh each time, which
# the startup dialog can make a work disk of (plans/workdisks.md)
run: $(RUNDEPS)
	$(RM) $(BLANKD81)
	c1541 -format blank,9a d81 $(BLANKD81)
	$(EMUCMD) $(D81FILE) -9 $(BLANKD81)

# Runs the IDE with a work disk on unit 9, which it finds and uses without
# the startup dialog. The disk is made once, as wdCreate makes one (the
# marker, runtimeN and themes.dat), and kept, so work on it lasts between
# runs; make clean removes it.
runwork: $(RUNDEPS) $(WORKD81)
	$(EMUCMD) $(D81FILE) -9 $(WORKD81)

$(WORKMARKER): $(MKMARKER) src/asminc/workdisk.inc | $(BINTARGETDIR)
	python3 $(MKMARKER) src/asminc/workdisk.inc $@

$(WORKD81): $(WORKMARKER) $(RUNTIME) $(THEMESDEF)
	$(RM) $@
	c1541 -format work,9a d81 $@ \
	-write $(RUNTIMEDIR)/bin/$(TARGET)/runtime$(RTABI) runtime$(RTABI),prg \
	-write $(THEMESDEF) themes.dat,seq \
	-write $(WORKMARKER) p65work,seq

.PHONY: run runwork

load: $(D81FILE)
	mega65_ftp -e -c 'put $(D81FILE)' -c 'exit'
	etherload -m pascal65.d81 -r src/apps/editor/bin/$(TARGET)/editor

# Runs the test programs in the emulator (xmega65) one after another and stops
# at the first failure. Each suite builds itself, runs headless, and reports
# PASS or FAIL (see src/apps/testcommon/runtest.sh). Set TEST_TIMEOUT to change
# the per-suite time limit in seconds.
TESTDIRS := tokenizertest parsertest resolvertest typechecktest icodetest tputest \
	compilertestasm memtest membuftest runtimetest editortest themestest \
	workdisktest compilerasm

test: mkthemes-test
	@for t in $(TESTDIRS); do \
		$(MAKE) -C src/apps/$$t TARGET=$(TARGET) test || exit 1; \
	done
	@echo "All tests passed"

.PHONY: test
